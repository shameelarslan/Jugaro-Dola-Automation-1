// 7. LOGS
async function fetchLogs() {
    const res = await apiRequest("/logs");
    if (res.success && res.logs) {
        const consoleEl = document.getElementById("full-logs-console");
        const miniEl = document.getElementById("mini-logs-console");
        
        if (consoleEl && res.logs.length > 0) {
            consoleEl.innerHTML = res.logs.map(l => {
                let cls = "info";
                if (l.includes("WARN")) cls = "warn";
                if (l.includes("ERROR") || l.includes("CRASH") || l.includes("FAILED")) cls = "error";
                if (l.includes("SUCCESS") || l.includes("COMPLETED")) cls = "success";
                return `<div class="log-line ${cls}">${escapeHtml(l)}</div>`;
            }).join("");
            consoleEl.scrollTop = consoleEl.scrollHeight;
        }

        if (miniEl && res.logs.length > 0) {
            const recent = res.logs.slice(-15);
            miniEl.innerHTML = recent.map(l => {
                let cls = "info";
                if (l.includes("WARN")) cls = "warn";
                if (l.includes("ERROR") || l.includes("CRASH")) cls = "error";
                if (l.includes("SUCCESS") || l.includes("COMPLETED")) cls = "success";
                return `<div class="log-line ${cls}">${escapeHtml(l)}</div>`;
            }).join("");
            miniEl.scrollTop = miniEl.scrollHeight;
        }
    }
}

// 8. SUPER ADMIN
async function fetchSuperAdminData() {
    const res = await apiRequest("/super-admin/data");
    if (res.success && res.super_admin) {
        const sa = res.super_admin;
        appState.superAdmin = sa;
        appState.superAdminUsers = sa.all_users || [];

        animateCounter("sa-total-users", sa.total_users || 0);
        animateCounter("sa-pending-users", sa.pending_users || 0);
        animateCounter("sa-total-videos", sa.total_videos_all_time || 0);

        const totalVideos = sa.total_videos_all_time || 0;
        const totalUsers = sa.total_users || 1;
        const avg = (totalVideos / totalUsers).toFixed(1);
        animateCounter("sa-avg-videos", avg);

        renderSuperAdminTable(appState.superAdminUsers);
        renderSuperAdminCharts(appState.superAdminUsers);
    }
}

function renderSuperAdminTable(users) {
    const tbody = document.getElementById("super-admin-table-body");
    if (!tbody) return;

    if (!users || users.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color: var(--text-muted); padding: 32px;">No creators registered in cloud database.</td></tr>`;
        return;
    }

    tbody.innerHTML = users.map(u => {
        const uRole = u.role || "free";
        return `
        <tr>
            <td style="font-weight: 700; color: #ffffff;">${escapeHtml(u.email)}</td>
            <td>${escapeHtml(u.name || 'Creator')}</td>
            <td style="font-family: var(--font-mono); font-weight: 700; color: var(--accent);">${u.total_videos || 0}</td>
            <td>
                <span class="badge ${u.status === 'Active' ? 'badge-green' : (u.status === 'Pending' ? 'badge-yellow' : 'badge-red')}">${u.status}</span>
            </td>
            <td>
                <select class="role-select" onchange="changeUserRole('${u.user_id}', this.value)">
                    <option value="free" ${uRole === 'free' ? 'selected' : ''}>🟢 Free User</option>
                    <option value="paid" ${uRole === 'paid' ? 'selected' : ''}>⭐ Paid User</option>
                    <option value="admin" ${uRole === 'admin' ? 'selected' : ''}>👑 Admin</option>
                </select>
            </td>
            <td>
                ${u.status === 'Pending' ? `<button class="btn btn-accent btn-sm" onclick="toggleUserStatus('${u.user_id}', 'Active')">Approve</button>` : ''}
                ${u.status === 'Active' ? `<button class="btn btn-danger btn-sm" onclick="toggleUserStatus('${u.user_id}', 'Blocked')">Block</button>` : ''}
                ${u.status === 'Blocked' ? `<button class="btn btn-accent btn-sm" onclick="toggleUserStatus('${u.user_id}', 'Active')">Unblock</button>` : ''}
            </td>
        </tr>`;
    }).join("");
}

async function changeUserRole(userId, newRole) {
    const res = await apiRequest("/super-admin/update-role", "POST", {
        user_id: userId,
        new_role: newRole
    });
    if (res.success) {
        fetchSuperAdminData();
    } else {
        alert(`Error updating role: ${res.error}`);
    }
}

function renderSuperAdminCharts(users) {
    if (typeof Chart === "undefined" || !users || users.length === 0) return;

    // 1. Top 10 Creators Bar Chart
    const sortedUsers = [...users].sort((a, b) => (b.total_videos || 0) - (a.total_videos || 0)).slice(0, 10);
    const labels = sortedUsers.map(u => u.name || u.email.split("@")[0]);
    const videoCounts = sortedUsers.map(u => u.total_videos || 0);

    const ctxTop = document.getElementById("chart-top-creators");
    if (ctxTop) {
        if (superAdminCharts.topCreators) superAdminCharts.topCreators.destroy();
        superAdminCharts.topCreators = new Chart(ctxTop, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Total Videos Generated',
                    data: videoCounts,
                    backgroundColor: 'rgba(139, 92, 246, 0.75)',
                    borderColor: '#8b5cf6',
                    borderWidth: 1.5,
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: { ticks: { color: '#94a3b8', font: { size: 11 } }, grid: { display: false } },
                    y: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255, 255, 255, 0.05)' } }
                }
            }
        });
    }

    // 2. Status Donut Chart
    const activeCount = users.filter(u => u.status === 'Active').length;
    const pendingCount = users.filter(u => u.status === 'Pending').length;
    const blockedCount = users.filter(u => u.status === 'Blocked').length;

    const ctxDonut = document.getElementById("chart-status-donut");
    if (ctxDonut) {
        if (superAdminCharts.statusDonut) superAdminCharts.statusDonut.destroy();
        superAdminCharts.statusDonut = new Chart(ctxDonut, {
            type: 'doughnut',
            data: {
                labels: ['Active Creators', 'Pending Approvals', 'Blocked Accounts'],
                datasets: [{
                    data: [activeCount, pendingCount, blockedCount],
                    backgroundColor: ['#10b981', '#fbbf24', '#f43f5e'],
                    borderWidth: 2,
                    borderColor: '#070913'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { color: '#f8fafc', font: { size: 12, weight: 'bold' }, padding: 16 }
                    }
                },
                cutout: '70%'
            }
        });
    }

    // 3. Production Velocity Area Chart
    const ctxVelocity = document.getElementById("chart-production-velocity");
    if (ctxVelocity) {
        if (superAdminCharts.productionVelocity) superAdminCharts.productionVelocity.destroy();
        
        const bins = ['1-50 Vids', '51-150 Vids', '151-300 Vids', '301-500 Vids', '500+ Vids'];
        const binCounts = [
            users.filter(u => (u.total_videos || 0) >= 1 && (u.total_videos || 0) <= 50).length,
            users.filter(u => (u.total_videos || 0) > 50 && (u.total_videos || 0) <= 150).length,
            users.filter(u => (u.total_videos || 0) > 150 && (u.total_videos || 0) <= 300).length,
            users.filter(u => (u.total_videos || 0) > 300 && (u.total_videos || 0) <= 500).length,
            users.filter(u => (u.total_videos || 0) > 500).length
        ];

        superAdminCharts.productionVelocity = new Chart(ctxVelocity, {
            type: 'line',
            data: {
                labels: bins,
                datasets: [{
                    label: 'Creators Volume Capacity',
                    data: binCounts,
                    fill: true,
                    backgroundColor: 'rgba(6, 182, 212, 0.15)',
                    borderColor: '#06b6d4',
                    borderWidth: 2.5,
                    tension: 0.4,
                    pointBackgroundColor: '#38bdf8',
                    pointRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: { ticks: { color: '#94a3b8' }, grid: { display: false } },
                    y: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255, 255, 255, 0.05)' } }
                }
            }
        });
    }
}

async function toggleUserStatus(userId, newStatus) {
