{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/v2/tooling/cli/schema.json",
  "productName": "WaqasAutomationPro",
  "version": "2.1.1",
  "identifier": "com.waqasautomation.pro",
  "build": {
    "devUrl": "http://127.0.0.1:8765",
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Waqas Automation Pro v2.1.1",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "maximizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Waqas Shaukat",
    "copyright": "Waqas Automation",
    "category": "Productivity",
    "shortDescription": "Bulk video automation for Dola & Facebook",
    "longDescription": "Waqas Automation Pro automates Dola video generation, download verification and Facebook Reel publishing. The Python backend and Chromium browser ship inside the installer, so no extra setup is required.",
    "resources": [
      "resources/server/**/*",
      "resources/ms-playwright/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}
