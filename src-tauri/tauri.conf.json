{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/v2/tooling/cli/schema.json",
  "productName": "WaqasAutomationPro",
  "version": "2.1.1",
  "identifier": "com.waqasautomation.pro",
  "build": {
    "devUrl": "http://127.0.0.1:8765",
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Waqas Automation Pro v2.1.1",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "maximizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
